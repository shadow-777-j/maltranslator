<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Malayalam Voice to LCD</title>
    <style>
        body {
            font-family: sans-serif;
            background: #0d131f;
            color: #fff;
            text-align: center;
            padding: 20px;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 90vh;
        }

        .card {
            background: #192231;
            width: 100%;
            max-width: 380px;
            padding: 24px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            box-sizing: border-box;
        }

        h2 {
            margin-top: 0;
            font-size: 20px;
            margin-bottom: 20px;
            letter-spacing: 0.5px;
        }

        button {
            width: 100%;
            padding: 16px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 12px;
            border: none;
            margin: 10px 0;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        #btnConnect {
            background: #2563eb;
            color: white;
        }

        #btnMic {
            background: #10b981;
            color: white;
            display: none;
        }

        #btnMic.recording {
            background: #ef4444;
            animation: pulse 1.4s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(0.98); }
            100% { opacity: 1; transform: scale(1); }
        }

        #status {
            color: #94a3b8;
            font-size: 13px;
            margin: 12px 0;
            min-height: 18px;
        }

        .display-box {
            background: #232f42;
            padding: 14px;
            border-radius: 10px;
            text-align: left;
            margin-top: 10px;
        }

        .label {
            font-size: 11px;
            color: #8da2be;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .val {
            font-size: 17px;
            margin-top: 6px;
            min-height: 24px;
            color: #e2e8f0;
            word-wrap: break-word;
        }
    </style>
</head>

<body>

    <div class="card">
        <h2>Malayalam ➔ LCD</h2>

        <button id="btnConnect" onclick="connectBLE()">1. Connect to ESP32</button>
        <button id="btnMic" onclick="toggleRecording()">🎤 Push to Speak</button>

        <div id="status">Tap Connect to begin</div>

        <div class="display-box">
            <div class="label">Spoken (Malayalam):</div>
            <div id="mlText" class="val">-</div>
        </div>
    </div>

    <script>
        const SERVICE_UUID = "6e400001-b5a3-f393-e0a9-e50e24dcca9e";
        const CHAR_RX_UUID = "6e400002-b5a3-f393-e0a9-e50e24dcca9e";

        let rxCharacteristic = null;
        let recognition = null;
        let isRecording = false;
        let capturedText = "";

        async function connectBLE() {
            try {
                document.getElementById('status').innerText = "Scanning for ESP32...";

                const device = await navigator.bluetooth.requestDevice({
                    filters: [{ services: [SERVICE_UUID] }]
                });

                document.getElementById('status').innerText = "Connecting...";

                const server = await device.gatt.connect();
                const service = await server.getPrimaryService(SERVICE_UUID);
                rxCharacteristic = await service.getCharacteristic(CHAR_RX_UUID);

                document.getElementById('status').innerText = "Connected! Ready to speak.";
                document.getElementById('btnConnect').style.display = "none";
                document.getElementById('btnMic').style.display = "block";
            } catch (err) {
                document.getElementById('status').innerText = "BLE Error: " + err;
            }
        }

        function createRecognitionInstance() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Please use Chrome on Android.");
                return null;
            }

            const rec = new SpeechRecognition();
            rec.lang = 'ml-IN';
            rec.interimResults = true;
            rec.continuous = false; // Disables Android internal buffer accumulation

            rec.onresult = (event) => {
                let latest = "";
                for (let i = 0; i < event.results.length; ++i) {
                    latest = event.results[i][0].transcript;
                }
                if (latest) {
                    capturedText = latest.trim();
                    document.getElementById('mlText').innerText = capturedText;
                }
            };

            rec.onerror = (e) => {
                if (e.error !== 'no-speech') {
                    console.error("Speech error:", e);
                }
            };

            rec.onend = () => {
                // If user didn't tap stop but browser timed out, restart instance seamlessly
                if (isRecording) {
                    try {
                        rec.start();
                    } catch (e) {}
                }
            };

            return rec;
        }

        async function toggleRecording() {
            const btn = document.getElementById('btnMic');
            const status = document.getElementById('status');

            if (!isRecording) {
                // START RECORDING
                capturedText = "";
                document.getElementById('mlText').innerText = "കേൾക്കുന്നു (Listening)...";

                isRecording = true;
                btn.classList.add('recording');
                btn.innerText = "🛑 Stop & Send to LCD";
                status.innerText = "Listening... Speak Malayalam freely.";

                if (!recognition) {
                    recognition = createRecognitionInstance();
                }
                try {
                    recognition.start();
                } catch (e) {
                    recognition = createRecognitionInstance();
                    recognition.start();
                }
            } else {
                // STOP RECORDING
                isRecording = false;
                btn.classList.remove('recording');
                btn.innerText = "🎤 Push to Speak";

                if (recognition) {
                    recognition.onresult = null; // Prevent trailing events from re-appending
                    recognition.onend = null;
                    recognition.stop();
                    recognition = null;
                }

                const cleaned = capturedText.trim();
                if (!cleaned) {
                    status.innerText = "No speech detected. Try again.";
                    document.getElementById('mlText').innerText = "-";
                    return;
                }

                document.getElementById('mlText').innerText = cleaned;
                status.innerText = "Translating & sending to LCD...";

                // Translate to English in background
                const translatedEn = await translateMLtoEN(cleaned);

                // Send clean English directly to ESP32
                await sendToLCD(translatedEn);
                status.innerText = "✨ Sent to LCD!";
            }
        }

        async function translateMLtoEN(text) {
            try {
                const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=ml|en`);
                const data = await res.json();
                return data.responseData.translatedText || "Translation err";
            } catch (e) {
                return "Network err";
            }
        }

        async function sendToLCD(text) {
            if (!rxCharacteristic) return;
            const encoder = new TextEncoder();
            await rxCharacteristic.writeValue(encoder.encode(text));
        }
    </script>
</body>

</html>